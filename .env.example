# ============================================================
# WritingCoach - LLM Provider Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# LLM provider: "anthropic" (cloud, for dev/testing) or "ollama" (local, airgap)
LLM_PROVIDER=anthropic

# ---- Anthropic (cloud, development/testing) ----
ANTHROPIC_API_KEY=your-api-key-here

# ---- Ollama (local, airgap-compliant production) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Recipes directory (default: ./recipes) ----
RECIPES_DIR=./recipes
