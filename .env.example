# ============================================================
# WritingCoach - LLM Provider Configuration
# ============================================================
# Copy this file to .env and fill in the section for your provider.
# Set LLM_PROVIDER to one of: openai | ollama | anthropic | cohere

LLM_PROVIDER=openai

# ---- OpenAI-compatible (internal AI server / vLLM / LocalAI / LM Studio / Azure) ----
# Point OPENAI_BASE_URL to your internal AI server.
# If the server requires no key, set any non-empty string.
OPENAI_BASE_URL=http://my-internal-server:8000/v1
OPENAI_API_KEY=internal-token
OPENAI_MODEL=my-model-name

# ---- Ollama (local / air-gap) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Anthropic Claude (cloud) ----
ANTHROPIC_API_KEY=your-api-key-here

# ---- Cohere (cloud or on-prem) ----
# For on-prem: set COHERE_BASE_URL to your internal endpoint.
COHERE_API_KEY=your-cohere-key
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_MODEL=command-r-plus

# ---- Recipes directory (default: ./recipes) ----
# RECIPES_DIR=./recipes

# ---- CORS (optional — restrict API access by origin) ----
# Leave unset to allow all origins (required for same-origin Railway deploys).
# ALLOWED_ORIGINS=https://your-domain.com,https://other.domain.com
